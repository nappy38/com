<?xml version="1.0" encoding="utf-8"?>
<!-- ランチャーのマスク形状(円/角丸四角など)で端が切れないよう、
     元画像より一回り小さく中央寄せして安全マージンを確保する -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground_art"
    android:insetLeft="14%"
    android:insetTop="14%"
    android:insetRight="14%"
    android:insetBottom="14%" />
